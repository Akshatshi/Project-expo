# Copy this file to ".env" and fill in your values. NEVER commit ".env" and never share the key publicly.

# --- AI roadmap + mentor (Google Gemini API) ---
# Get a free key at https://aistudio.google.com/apikey  (leave empty to use the built-in fallback roadmap)
GEMINI_API_KEY=
# Any Gemini model your key can use, e.g. gemini-flash-latest (always the newest Flash model) or a fixed name such as gemini-3.6-flash
GEMINI_MODEL=gemini-flash-latest
# Backup model, used automatically when the main one is slow or unavailable
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# true = roadmap appears instantly and the AI version is written in the background
AI_ASYNC=true

# --- Security ---
# Long random string used to sign login tokens. If empty, one is generated and saved in backend/instance/secret.key
SECRET_KEY=

# --- CORS: comma separated list of frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000

# --- Misc ---
DATABASE_PATH=instance/skillmatrix.db
# For free online hosting use a PostgreSQL URL (Neon / Supabase). If set, it is used instead of the SQLite file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# true  = password-reset link / user id are shown on screen (no email server in a college project)
DEV_MODE=true
PORT=5000
